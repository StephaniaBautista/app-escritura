# Backend Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=3001
NODE_ENV=development

# Trust X-Forwarded-* headers (only set to true in production behind a proxy
# managed by the platform, e.g. Vercel/Railway/Cloudflare). Enables the rate
# limit to use the real client IP instead of the proxy IP.
TRUST_PROXY=false

# Database (local Docker by default; replace with the Supabase URI in production)
DATABASE_URL=postgresql://archivum:archivum-local@localhost:54329/archivum?schema=public

# Auth (BetterAuth)
# Generate a random production secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=archivum-local-development-secret-change-before-production
BETTER_AUTH_URL=http://localhost:3001

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173

# CORS Origins (comma-separated, no spaces around commas)
CORS_ORIGINS=http://localhost:5173,http://localhost:5175

# Email (Gmail SMTP)
# To use Gmail:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Generate an App Password for "Mail"
# 3. Use that password below (not your Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Google OAuth (for production)
# To set up:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID
# 3. Add authorized redirect URI: https://your-backend-url/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI APIs
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.5-pro
AI_FALLBACK_ENABLED=false
AI_TIMEOUT_MS=45000

# Supabase Storage (Fase 5 — character images; M65 — race images in a separate bucket)
# Get both from: Supabase Dashboard > Settings > API
# Project URL: https://[YOUR_PROJECT_REF].supabase.co
# Service role key: the `service_role` secret (NEVER expose it to the frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Defaults to race-images (created automatically on first upload if missing).
# SUPABASE_RACE_BUCKET=race-images
# Optional. Defaults to creature-images (created automatically on first upload if missing).
# SUPABASE_CREATURE_BUCKET=creature-images

# PhotoRoom — background removal for height-map full-body photos only
# https://www.photoroom.com/api
PHOTOROOM_API_KEY=

# Rate limits (optional — production-safe defaults apply if unset)
# Raise ONLY in dev/E2E: the E2E suite logs in ~35 times per full run and can
# exhaust the windows. RATE_MAX = global per-IP per minute; AUTH_RATE_MAX =
# auth endpoints per-IP per 15 minutes.
# RATE_MAX=100
# AUTH_RATE_MAX=500
