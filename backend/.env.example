# Backend Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=3001
NODE_ENV=development

# Trust X-Forwarded-* headers (only set to true in production behind a proxy
# managed by the platform, e.g. Vercel/Railway/Cloudflare). Enables the rate
# limit to use the real client IP instead of the proxy IP.
TRUST_PROXY=false

# Database (Supabase)
# Get this from: Supabase Dashboard > Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres

# Auth (BetterAuth)
# Generate a random secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:3001

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173

# CORS Origins (comma-separated, no spaces around commas)
CORS_ORIGINS=http://localhost:5173

# Email (Gmail SMTP)
# To use Gmail:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Generate an App Password for "Mail"
# 3. Use that password below (not your Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Google OAuth (for production)
# To set up:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID
# 3. Add authorized redirect URI: https://your-backend-url/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI APIs
DEEPSEEK_API_KEY=your-deepseek-api-key
MIMO_API_KEY=your-mimo-api-key

# Supabase Storage (Fase 5 — character images)
# Get both from: Supabase Dashboard > Settings > API
# Project URL: https://[YOUR_PROJECT_REF].supabase.co
# Service role key: the `service_role` secret (NEVER expose it to the frontend)
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Rate limits (optional — production-safe defaults apply if unset)
# Raise ONLY in dev/E2E: the E2E suite logs in ~35 times per full run and can
# exhaust the windows. RATE_MAX = global per-IP per minute; AUTH_RATE_MAX =
# auth endpoints per-IP per 15 minutes.
# RATE_MAX=100
# AUTH_RATE_MAX=500
