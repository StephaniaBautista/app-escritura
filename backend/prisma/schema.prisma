// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

// User model for authentication
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user") // role name, matching Role.name (user | superadmin | custom)
  status        String    @default("active") // active | suspended | banned
  suspendedUntil DateTime? // end of suspension; null unless suspended
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Better Auth relations
  sessions      Session[]
  accounts      Account[]

  // App relations
  projects      Project[]
  documents     Document[]
  notes         Note[]
  versions      DocumentVersion[]
  branches      Branch[]
  settings      UserSettings?
  activities    Activity[]
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// Project model for organizing documents
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Wizard metadata (Fase 4 — Modo de Creación): rating, tipo, fanfic, ships, estructura, etc.
  // Se guarda en el proyecto como datos extra. NUNCA como documento.
  storyMeta Json @default("{}")

  // Relations
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents   Document[]
  folders     Folder[]
  characters  Character[]
  worlds      World[]
  diagrams    Diagram[]
  notes       Note[]
  timelineEvents  TimelineEvent[]
  timelineEras    TimelineEra[]
  relationships   CharacterRelationship[]
  loreEntries      LoreEntry[]
  races            Race[]
  glossaryEntries  GlossaryEntry[]
  creatures        Creature[]
  locations        Location[]
  worldRoutes      WorldRoute[]

  @@map("projects")
}

// Folder model for organizing documents within projects
model Folder {
  id        String   @id @default(cuid())
  name      String
  projectId String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    Folder?    @relation("FolderHierarchy", fields: [parentId], references: [id])
  children  Folder[]   @relation("FolderHierarchy")
  documents Document[]

  @@map("folders")
}

// Document model for storing written content (also used for chapters/subpages)
model Document {
  id        String   @id @default(cuid())
  title     String
  content   Json     @default("{}")
  type      String   @default("document") // document | chapter | subpage
  order     Int      @default(0)
  userId    String
  projectId String
  folderId  String?
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  autoVersionState Json @default("{}")

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  parent    Document?  @relation("DocumentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Document[] @relation("DocumentTree")
  notes     Note[]
  versions  DocumentVersion[]
  branches  Branch[]

  @@index([projectId])
  @@index([parentId])
  @@index([userId])
  @@map("documents")
}

// Note model for sticky-note style notes (per document or per project/story)
model Note {
  id         String   @id @default(cuid())
  title      String
  content    String   @default("")
  documentId String?
  projectId  String?
  isHidden   Boolean  @default(false)
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  document  Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([projectId])
  @@index([userId])
  @@map("notes")
}

// DocumentVersion model for linear versioning (snapshots)
model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  branchId   String?
  title      String
  content    Json     @default("{}")
  version    Int
  userId     String
  createdAt  DateTime @default(now())

  // Relations
  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  branch    Branch?  @relation("BranchVersions", fields: [branchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parents   VersionParent[] @relation("ChildVersion")
  children  VersionParent[] @relation("ParentVersion")
  sourceBranches Branch[]     @relation("BranchSource")

  @@unique([branchId, version])
  @@index([documentId])
  @@index([branchId])
  @@index([userId])
  @@map("document_versions")
}

// Branch model for versioning branches (Git-like)
model Branch {
  id              String    @id @default(cuid())
  documentId      String
  name            String
  sourceVersionId String?
  userId          String
  createdAt       DateTime  @default(now())

  document      Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceVersion DocumentVersion? @relation("BranchSource", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  versions      DocumentVersion[] @relation("BranchVersions")

  @@unique([documentId, name])
  @@index([documentId])
  @@map("branches")
}

// VersionParent model for merge commits (many-to-many parent relationship)
model VersionParent {
  versionId String
  parentId  String

  version DocumentVersion @relation("ChildVersion", fields: [versionId], references: [id], onDelete: Cascade)
  parent  DocumentVersion @relation("ParentVersion", fields: [parentId], references: [id], onDelete: Cascade)

  @@id([versionId, parentId])
  @@map("version_parents")
}

model UserSettings {
  id         String @id @default(cuid())
  userId     String @unique
  theme      String @default("system")
  language   String @default("es")
  autoVersion Json  @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// Character model for story characters (Fase 5)
model Character {
  id              String    @id @default(cuid())
  projectId       String
  name            String
  description     String?
  imageUrl        String?
  sheetBackgroundMode   String    @default("default")
  sheetBackgroundImages String[]  @default([])
  nicknames       String[]  @default([])
  age             String?
  gender          String?
  heightCm        Int?
  orientation     String?
  maritalStatus   String?
  species         String?
  birthPlace      String?
  birthDate       String?
  role            String?
  roleSpec        String?
  isOC            Boolean   @default(false)
  parentIds       String[]  @default([])
  evolvesFromId   String?
  evolutionReason String?
  storyPoint      String?
  attributes      Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evolvesFrom Character?  @relation("CharacterEvolution", fields: [evolvesFromId], references: [id], onDelete: SetNull)
  evolutions  Character[] @relation("CharacterEvolution")
  relationshipsA CharacterRelationship[] @relation("RelA")
  relationshipsB CharacterRelationship[] @relation("RelB")

  @@index([projectId])
  @@map("characters")
}

// World model for worldbuilding
model World {
  id          String   @id @default(cuid())
  name        String
  description String?
  content     Json     @default("{}")
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("worlds")
}

// Lore entry (Fase 7) — mundo: magia, facciones, religión, objetos, etc.
// type: magic | faction | religion | location | item | custom
model LoreEntry {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  type        String   @default("custom")
  limits      String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("lore_entries")
}

// Race / people (Fase 7) — razas y pueblos del mundo
model Race {
  id               String   @id @default(cuid())
  projectId        String
  name             String
  classification   String?
  description      String?
  physicalTraits   String?
  hasMagic         Boolean  @default(false)
  magicDescription String?
  lifeExpectancy   Int?
  language         String?
  culture          String?
  religion         String?
  origin           String?
  territory        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("races")
}

// Glossary entry (Fase 7) — palabra, pronunciación, significado
model GlossaryEntry {
  id            String   @id @default(cuid())
  projectId     String
  word          String
  pronunciation String?
  meaning       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("glossary_entries")
}

// Creature / beast (Fase 7) — bestias y criaturas
model Creature {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  species     String?
  dangerType  String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("creatures")
}

// Location (Fase 7) — nodo del mapa mundial
model Location {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  position    Json     @default("{}") // { x, y } en el lienzo del mapa
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  routesA   WorldRoute[] @relation("RouteA")
  routesB   WorldRoute[] @relation("RouteB")

  @@index([projectId])
  @@map("locations")
}

// WorldRoute (Fase 7) — ruta/conexión entre dos ubicaciones (normalizado A < B)
model WorldRoute {
  id          String   @id @default(cuid())
  projectId   String
  locationAId String
  locationBId String
  label       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  locationA Location @relation("RouteA", fields: [locationAId], references: [id], onDelete: Cascade)
  locationB Location @relation("RouteB", fields: [locationBId], references: [id], onDelete: Cascade)

  @@unique([locationAId, locationBId])
  @@index([projectId])
  @@map("world_routes")
}

// Diagram model for plot diagrams
// type: familyTree (auto-generado desde parentIds) | relationships (auto desde CharacterRelationship) | custom (manual)
// layout: { nodes: [{ id: characterId, position }], notes: [{ id, position, text }] } — edges se derivan de los datos
model Diagram {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("custom")
  data      Json     @default("{}")
  layout    Json     @default("{}")
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("diagrams")
}

// TimelineEra model — "épocas" que agrupan eventos en franjas del tablero
model TimelineEra {
  id        String   @id @default(cuid())
  projectId String
  name      String
  color     String?
  precision String   @default("year") // year | month | week | day | hour | minute
  startDate String?
  endDate   String?
  rollover  String   @default("newYear") // newYear | afterYear
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("timeline_eras")
}

// TimelineEvent model for the story timeline (Fase 6)
model TimelineEvent {
  id           String   @id @default(cuid())
  projectId    String
  title        String
  date         String?             // texto libre: "Año 3", "Era de los dragones"
  description  String?
  order        Int      @default(0)
  eraId        String?             // época/franja a la que pertenece (null → General)
  characterIds String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("timeline_events")
}

// CharacterRelationship model (Fase 6) — relación estructurada A ↔ B
// type: romance | friendship | enemity | family | custom (label si custom)
// Normalizado: characterAId < characterBId para el @unique (relación simétrica)
model CharacterRelationship {
  id           String   @id @default(cuid())
  projectId    String
  characterAId String
  characterBId String
  type         String
  label        String?
  description  String?
  lineColor    String?
  lineStyle    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  characterA Character @relation("RelA", fields: [characterAId], references: [id], onDelete: Cascade)
  characterB Character @relation("RelB", fields: [characterBId], references: [id], onDelete: Cascade)

  @@unique([characterAId, characterBId])
  @@index([projectId])
  @@map("character_relationships")
}

// StoryOption model for reusable wizard options per user (Fase 4)
// userId = null → system defaults (seeded). userId = X → user-created custom options.
model StoryOption {
  id        String   @id @default(cuid())
  type      String   // rating | storyType | category | narrator | ending | fandom | tag | problem | ship | character
  value     String
  label     String
  fandoms   String[] @default([]) // fandoms a los que pertenece (ships/characters); vacío = general
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([type, value])
  @@index([type])
  @@map("story_options")
}

// StoryQuestion model for the guided-mode question bank (Slice 5, Fase 4)
// Preguntas globales de respuesta abierta; el admin las gestiona en el panel.
model StoryQuestion {
  id        String   @id @default(cuid())
  text      String
  textEn    String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("story_questions")
}

// StoryTemplate model for structure templates (Slice 5, Fase 4)
// Plantilla = nombre + secciones (Inicio/Desarrollo/Clímax/Final o custom) con las
// preguntas del banco asignadas por sección. Gestionadas por el admin.
model StoryTemplate {
  id            String   @id @default(cuid())
  name          String
  nameEn        String?
  description   String?
  descriptionEn String?
  sections      Json     @default("[]") // [{ id, title, titleEn, questionIds: [] }]
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@map("story_templates")
}

// Activity feed (M29): actividad reciente del usuario, antes en localStorage.
// Un único modelo por usuario, sin datos de otro tenant.
model Activity {
  id         String   @id @default(cuid())
  type       String   // folder_created | document_created | document_edited
  title      String
  folderId   String?
  documentId String?
  userId     String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("activity")
}

// Catálogo de roles (Fase 04c): gestionable por el superadmin. User.role almacena el nombre.
model Role {
  id          String   @id @default(cuid())
  name        String   @unique // 'user' | 'superadmin' | custom
  label       String
  permissions String[] @default([]) // admin | moderate
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("roles")
}

// Catálogo estático de opciones del formulario de personaje (M41): listas servidas
// por API de solo lectura. Character guarda el valor como string libre (híbrido:
// la tabla sugiere, el usuario puede escribir valores custom).
model CharacterOption {
  id        String   @id @default(cuid())
  type      String   // gender | orientation | maritalStatus | role
  value     String   // valor canónico que se guarda en Character
  label     String   // etiqueta ES
  labelEn   String?  // etiqueta EN
  sortOrder Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([type, value])
  @@index([type])
  @@map("character_options")
}

// Secciones estándar de estructura (M41): ids fijos que los templates referencian
// en su JSON `sections`. Fuente de validación para el banco de plantillas.
model StorySection {
  id        String   @id // 'inicio' | 'desarrollo' | 'climax' | 'final'
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("story_sections")
}
