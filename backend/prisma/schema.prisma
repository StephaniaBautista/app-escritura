// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

// User model for authentication
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Better Auth relations
  sessions      Session[]
  accounts      Account[]

  // App relations
  projects      Project[]
  documents     Document[]
  notes         Note[]
  versions      DocumentVersion[]
  branches      Branch[]
  settings      UserSettings?
  storyOptions  StoryOption[]
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// Project model for organizing documents
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Wizard metadata (Fase 4 — Modo de Creación): rating, tipo, fanfic, ships, estructura, etc.
  // Se guarda en el proyecto como datos extra. NUNCA como documento.
  storyMeta Json @default("{}")

  // Relations
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents   Document[]
  folders     Folder[]
  characters  Character[]
  worlds      World[]
  diagrams    Diagram[]
  notes       Note[]

  @@map("projects")
}

// Folder model for organizing documents within projects
model Folder {
  id        String   @id @default(cuid())
  name      String
  projectId String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    Folder?    @relation("FolderHierarchy", fields: [parentId], references: [id])
  children  Folder[]   @relation("FolderHierarchy")
  documents Document[]

  @@map("folders")
}

// Document model for storing written content (also used for chapters/subpages)
model Document {
  id        String   @id @default(cuid())
  title     String
  content   Json     @default("{}")
  type      String   @default("document") // document | chapter | subpage
  order     Int      @default(0)
  userId    String
  projectId String
  folderId  String?
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  autoVersionState Json @default("{}")

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  parent    Document?  @relation("DocumentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Document[] @relation("DocumentTree")
  notes     Note[]
  versions  DocumentVersion[]
  branches  Branch[]

  @@index([projectId])
  @@index([parentId])
  @@index([userId])
  @@map("documents")
}

// Note model for sticky-note style notes (per document or per project/story)
model Note {
  id         String   @id @default(cuid())
  title      String
  content    String   @default("")
  documentId String?
  projectId  String?
  isHidden   Boolean  @default(false)
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  document  Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([projectId])
  @@index([userId])
  @@map("notes")
}

// DocumentVersion model for linear versioning (snapshots)
model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  branchId   String?
  title      String
  content    Json     @default("{}")
  version    Int
  userId     String
  createdAt  DateTime @default(now())

  // Relations
  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  branch    Branch?  @relation("BranchVersions", fields: [branchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parents   VersionParent[] @relation("ChildVersion")
  children  VersionParent[] @relation("ParentVersion")
  sourceBranches Branch[]     @relation("BranchSource")

  @@unique([branchId, version])
  @@index([documentId])
  @@index([branchId])
  @@index([userId])
  @@map("document_versions")
}

// Branch model for versioning branches (Git-like)
model Branch {
  id              String    @id @default(cuid())
  documentId      String
  name            String
  sourceVersionId String?
  userId          String
  createdAt       DateTime  @default(now())

  document      Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceVersion DocumentVersion? @relation("BranchSource", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  versions      DocumentVersion[] @relation("BranchVersions")

  @@unique([documentId, name])
  @@index([documentId])
  @@map("branches")
}

// VersionParent model for merge commits (many-to-many parent relationship)
model VersionParent {
  versionId String
  parentId  String

  version DocumentVersion @relation("ChildVersion", fields: [versionId], references: [id], onDelete: Cascade)
  parent  DocumentVersion @relation("ParentVersion", fields: [parentId], references: [id], onDelete: Cascade)

  @@id([versionId, parentId])
  @@map("version_parents")
}

model UserSettings {
  id         String @id @default(cuid())
  userId     String @unique
  theme      String @default("system")
  language   String @default("es")
  autoVersion Json  @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// Character model for story characters
model Character {
  id          String   @id @default(cuid())
  name        String
  description String?
  attributes  Json     @default("{}")
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("characters")
}

// World model for worldbuilding
model World {
  id          String   @id @default(cuid())
  name        String
  description String?
  content     Json     @default("{}")
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("worlds")
}

// Diagram model for plot diagrams
model Diagram {
  id        String   @id @default(cuid())
  name      String
  data      Json     @default("{}")
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("diagrams")
}

// StoryOption model for reusable wizard options per user (Fase 4)
// userId = null → system defaults (seeded). userId = X → user-created custom options.
model StoryOption {
  id        String   @id @default(cuid())
  userId    String?
  type      String   // rating | storyType | category | narrator | ending | fandom | tag | problem
  value     String
  label     String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, value])
  @@index([type])
  @@index([userId])
  @@map("story_options")
}
