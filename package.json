{
  "name": "archivum",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de escritura creativa con IA",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "setup:local": "node scripts/ensure-local-env.mjs && pnpm install --frozen-lockfile && pnpm db:up && pnpm db:push && pnpm prisma:generate",
    "dev": "pnpm -r --parallel run dev",
    "dev:frontend": "pnpm --filter frontend run dev",
    "dev:backend": "pnpm --filter backend run dev",
    "build": "pnpm -r run build",
    "build:frontend": "pnpm --filter frontend run build",
    "build:backend": "pnpm --filter backend run build",
    "lint": "pnpm -r run lint",
    "lint:frontend": "pnpm --filter frontend run lint",
    "lint:backend": "pnpm --filter backend run lint",
    "typecheck": "pnpm -r run typecheck",
    "typecheck:frontend": "pnpm --filter frontend run typecheck",
    "typecheck:backend": "pnpm --filter backend run typecheck",
    "test": "pnpm -r run test",
    "test:frontend": "pnpm --filter frontend run test",
    "test:backend": "pnpm --filter backend run test",
    "db:up": "docker compose up -d --wait database",
    "db:down": "docker compose down",
    "db:push": "pnpm --filter backend run prisma:push",
    "prisma:generate": "pnpm --filter backend run prisma:generate",
    "clean": "pnpm -r exec rm -rf node_modules dist .turbo"
  },
  "engines": {
    "node": ">=22.12.0 <25",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.79"
  }
}
